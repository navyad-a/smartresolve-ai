# SmartResolve AI Environment Configuration
# Provide your OpenAI API Key below to enable LLM-based triage.
# If left empty, the agent automatically runs in offline heuristic NLP fallback mode.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom endpoint (e.g. Groq, OpenRouter, Local Ollama)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
